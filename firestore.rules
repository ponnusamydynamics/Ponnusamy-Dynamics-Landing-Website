rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'ponnusamy.rickjarren@gmail.com'
      );
    }

    match /projects/{projectId} {
      // Anyone can read public project showcase documents
      allow read: if true;
      // Only authorized lab admin can create, modify or delete projects
      allow write: if isAdmin();
    }
  }
}
